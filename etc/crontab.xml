<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="magebit_mcp_audit_purge" instance="Magebit\Mcp\Cron\PurgeAuditLog" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="magebit_mcp_purge_oauth" instance="Magebit\Mcp\Cron\PurgeOAuthCodes" method="execute">
            <schedule>0 4 * * *</schedule>
        </job>
        <job name="magebit_mcp_check_module_updates" instance="Magebit\Mcp\Cron\CheckModuleUpdates" method="execute">
            <schedule>0 5 * * *</schedule>
        </job>
        <job name="magebit_mcp_job_mark_stale" instance="Magebit\Mcp\Cron\MarkStaleJobs" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="magebit_mcp_job_purge" instance="Magebit\Mcp\Cron\PurgeJobs" method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
    </group>
</config>
