<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="magebit_mcp_module_update" xsi:type="string">Magebit\Mcp\Model\System\Message\ModuleUpdateAvailable</item>
            </argument>
        </arguments>
    </type>
    <!-- Runs outside Magento's adminAuthentication plugin (sortOrder 100) so it sees the finished login. -->
    <type name="Magebit\Mcp\Controller\Adminhtml\Oauth\Authorize">
        <plugin name="magebit_mcp_return_to_consent_after_login"
                type="Magebit\Mcp\Plugin\Backend\ReturnToConsentAfterLogin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Backend\Model\UrlInterface">
        <plugin name="magebit_mcp_startup_page_to_pending_consent"
                type="Magebit\Mcp\Plugin\Backend\StartupPageToPendingConsent"/>
    </type>
    <type name="Magebit\Mcp\Model\OAuth\PendingConsent">
        <arguments>
            <argument name="session" xsi:type="object">Magento\Backend\Model\Session\Proxy</argument>
        </arguments>
    </type>
</config>
